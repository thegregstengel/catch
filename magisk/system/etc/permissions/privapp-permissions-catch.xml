<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged permissions for Catch. This device enforces the allowlist
  (ro.control_privapp_permissions=enforce): a privileged permission that Catch
  requests but that is missing here stops the device from booting. Ship any new
  entry in a module release before an app release that requests it.
-->
<permissions>
    <privapp-permissions package="app.catchrower.catch">
        <permission name="android.permission.INSTALL_PACKAGES" />
    </privapp-permissions>
</permissions>
